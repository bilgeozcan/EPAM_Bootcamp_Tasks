{
  "audit-producer-policy": {
    "resource_type": "iam_policy",
    "policy_content": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "AllowCloudWatchLogging",
          "Effect": "Allow",
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents"
          ],
          "Resource": "*"
        },
        {
          "Sid": "AllowConfigurationStreamRead",
          "Effect": "Allow",
          "Action": [
            "dynamodb:GetRecords",
            "dynamodb:GetShardIterator",
            "dynamodb:DescribeStream",
            "dynamodb:ListStreams"
          ],
          "Resource": "*"
        },
        {
          "Sid": "AllowAuditWrites",
          "Effect": "Allow",
          "Action": [
            "dynamodb:PutItem"
          ],
          "Resource": "*"
        }
      ]
    },
    "tags": {}
  },
  "audit-producer-role": {
    "resource_type": "iam_role",
    "principal_service": "lambda",
    "predefined_policies": [],
    "custom_policies": [
      "audit-producer-policy"
    ],
    "tags": {}
  },
  "Configuration": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "key",
    "hash_key_type": "S",
    "billing-mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "stream_view_type": "NEW_AND_OLD_IMAGES",
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "${target_table}": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing-mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  }
}