{
  "uuid_generator-policy": {
    "resource_type": "iam_policy",
    "policy_content": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "CloudWatchLogs",
          "Effect": "Allow",
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents"
          ],
          "Resource": "*"
        },
        {
          "Sid": "WriteUuidFilesToS3",
          "Effect": "Allow",
          "Action": [
            "s3:PutObject"
          ],
          "Resource": "*"
        }
      ]
    },
    "tags": {}
  },
  "uuid_generator-role": {
    "resource_type": "iam_role",
    "principal_service": "lambda",
    "predefined_policies": [],
    "custom_policies": [
      "uuid_generator-policy"
    ],
    "allowed_accounts": [],
    "instance_profile": false,
    "permissions_boundary": "",
    "tags": {}
  },
  "uuid-storage": {
    "resource_type": "s3_bucket",
    "acl": "private",
    "location": "${region}",
    "cors": [],
    "policy": {},
    "public_access_block": {
      "block_public_acls": true,
      "ignore_public_acls": true,
      "block_public_policy": true,
      "restrict_public_buckets": true
    },
    "tags": {}
  },
  "uuid_trigger": {
    "resource_type": "cloudwatch_rule",
    "rule_type": "schedule",
    "expression": "rate(1 minute)",
    "region": "${region}",
    "tags": {}
  }
}