#set($eventId = $util.autoId())
#set($createdAt = $util.time.nowISO8601())
#set($parsedPayLoad = $util.parseJson($ctx.args.payLoad))
{
  "version": "2018-05-29",
  "operation": "PutItem",
  "key": {
    "id": $util.dynamodb.toDynamoDBJson($eventId)
  },
  "attributeValues": {
    "userId": $util.dynamodb.toDynamoDBJson($ctx.args.userId),
    "createdAt": $util.dynamodb.toDynamoDBJson($createdAt),
    "payLoad": $util.dynamodb.toDynamoDBJson($parsedPayLoad)
  },
  "condition": {
    "expression": "attribute_not_exists(#id)",
    "expressionNames": {
      "#id": "id"
    }
  }
}