{
  "lambda-basic-execution": {
    "resource_type": "iam_policy",
    "policy_content": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "AllowEventsDynamoDBAccess",
          "Effect": "Allow",
          "Action": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:Batch*",
            "dynamodb:DeleteItem",
            "dynamodb:DescribeTable"
          ],
          "Resource": "*"
        }
      ]
    },
    "tags": {}
  },
  "appsync_role": {
    "resource_type": "iam_role",
    "principal_service": "appsync",
    "predefined_policies": [],
    "custom_policies": ["lambda-basic-execution"],
    "allowed_accounts": [],
    "instance_profile": false,
    "permissions_boundary": "",
    "tags": {}
  },
  "Events": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing-mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  }
}