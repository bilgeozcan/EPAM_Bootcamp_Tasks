{
    "appsync-dynamodb-policy":  {
                                    "resource_type":  "iam_policy",
                                    "policy_content":  {
                                                           "Version":  "2012-10-17",
                                                           "Statement":  [
                                                                             {
                                                                                 "Effect":  "Allow",
                                                                                 "Action":  [
                                                                                                "dynamodb:GetItem",
                                                                                                "dynamodb:PutItem",
                                                                                                "dynamodb:Query",
                                                                                                "dynamodb:DescribeTable"
                                                                                            ],
                                                                                 "Resource":  "*"
                                                                             }
                                                                         ]
                                                       },
                                    "tags":  {

                                             }
                                },
    "appsync_role":  {
                         "predefined_policies":  [

                                                 ],
                         "principal_service":  "appsync",
                         "custom_policies":  [
                                                 "appsync-dynamodb-policy"
                                             ],
                         "resource_type":  "iam_role",
                         "allowed_accounts":  [
                                                  "${account_id}"
                                              ],
                         "tags":  {

                                  }
                     },
    "IoT_DB":  {
                   "resource_type":  "dynamodb_table",
                   "hash_key_name":  "PK",
                   "hash_key_type":  "S",
                   "sort_key_name":  "SK",
                   "sort_key_type":  "S",
                   "billing_mode":  "PAY_PER_REQUEST",
                   "read_capacity":  1,
                   "write_capacity":  1,
                   "global_indexes":  [

                                      ],
                   "autoscaling":  [

                                   ],
                   "tags":  {

                            }
               }
}